# Copy this file to .env and fill in your real key.
# .env is git-ignored - never commit real API keys.

# The ONLY key the whole project needs - text mode AND voice mode both run
# on Groq. Get one free at https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# ---- Optional overrides (sensible defaults are used if you leave these blank) ----

# Groq chat model. llama-3.3-70b-versatile was deprecated by Groq in June 2026
# for free/dev-tier usage; openai/gpt-oss-120b is the current recommended
# production model. Check https://console.groq.com/docs/models for the latest.
GROQ_MODEL=openai/gpt-oss-120b

# Voice (--mode voice only) - both live-verified free on Groq's free tier,
# same key as above. GROQ_TTS_MODEL needs a one-time terms acceptance at
# https://console.groq.com/playground?model=canopylabs%2Forpheus-v1-english
# before your key can use it (a consent click, not a payment).
GROQ_STT_MODEL=whisper-large-v3-turbo
GROQ_TTS_MODEL=canopylabs/orpheus-v1-english
GROQ_TTS_VOICE=tara

# Safety valve for the LangGraph agent loop.
JARVIS_MAX_ITERATIONS=6